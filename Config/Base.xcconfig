// The bundle ID stays as is when the display name changes: signing and Keychain data depend on it.
PRODUCT_BUNDLE_IDENTIFIER = com.ehallmark.electrswatch
INFOPLIST_KEY_CFBundleDisplayName = Nightwatch
// No fixed style here: Settings > Appearance chooses, and the default is dark (see Theme.swift).
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// The embedded Tor does its own encryption, so this app doesn't only use Apple's.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = YES
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
ENABLE_USER_SCRIPT_SANDBOXING = YES
// For a real iPhone: create Config/Signing.local.xcconfig (ignored by git) containing
//   DEVELOPMENT_TEAM = YOUR_TEAM_ID
#include? "Signing.local.xcconfig"
